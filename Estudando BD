-- Liste o nome do paciente, o nome do médico e a especialidade da consulta
select p.nome as Paciente, m.nome_Medico as medico, esp.nome_Especialidade as especialidade
from consulta c
join Paciente p
on c.ID_paciente = p.ID_paciente
join medico m
on c.ID_medico = m.ID_medico
join especialidade esp
on esp.ID_especialidade = m.ID_especialidade;

-- Liste os exames solicitados em cada consulta, mostrando:
-- nome do paciente;
