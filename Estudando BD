-- nome do exame;
-- valor do exame.

select p.nome as Paciente, m.nome_Medico as medico, e.nome_Exame as exame, e.valor_Exame as valor 
from consulta c
join Paciente p
on c.ID_paciente = p.ID_paciente
join medico m
on c.ID_medico = m.ID_medico
join consulta_exame ce
on c.ID_consulta = ce.ID_consulta
join exame e
on ce.ID_Exame = e.ID_Exame;

